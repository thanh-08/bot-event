# Copy file này thành .env rồi điền giá trị thật. KHÔNG đưa .env lên GitHub.
TELEGRAM_TOKEN=dán_token_từ_BotFather
TELEGRAM_CHAT_IDS=dán_chat_id_của_bạn
# Tuỳ chọn (dùng AI để trích xuất). Có GEMINI_API_KEY thì dùng Gemini (miễn phí), nếu không thì thử ANTHROPIC_API_KEY.
# Cả hai để trống: bot dùng bộ trích xuất đơn giản (không dùng AI).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Tuỳ chọn: danh sách mô hình Gemini, cách nhau dấu phẩy; hết hạn mức hoặc lỗi 404 thì tự chuyển sang mô hình kế tiếp.
# Mặc định: gemini-3.5-flash-lite,gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
